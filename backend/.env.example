FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret

DB_HOST=localhost
DB_PORT=5432
DB_NAME=zulu_db
DB_USER=zulu_user
DB_PASSWORD=zulu_pass

DATABASE_URL=postgresql://zulu_user:zulu_pass@localhost:5432/zulu_db

# Redis
LIMITER_STORAGE_URL=redis://localhost:6379/0

# SMTP (Gmail example — use an App Password, not your regular password)
# https://support.google.com/accounts/answer/185833
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=rayanebicaba.dev@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=rayanebicaba.dev@gmail.com
MAIL_USE_TLS=true

GOOGLE_CLIENT_ID=ton-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ton-client-secret
GOOGLE_REDIRECT_URI=https://zawani-api.onrender.com/api/auth/google/callback
FRONTEND_URL=https://zawani.app

# Cloudinary (upload photos)
# https://cloudinary.com — Dashboard pour recuperer les credentials
CLOUDINARY_CLOUD_NAME=ton-cloud-name
CLOUDINARY_API_KEY=ton-api-key
CLOUDINARY_API_SECRET=ton-api-secret

# Utils
CLEAR_USERS_KEY=zulu-clear-2024

# AI (analyse de sentiment des commentaires)
AI_PROVIDER=gemini
